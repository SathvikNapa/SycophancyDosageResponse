OPENAI_API_KEY=enter_your_openai_api_key_here
ANTHROPIC_API_KEY=enter_your_anthropic_api_key_here
GOOGLE_API_KEY=enter_your_google_api_key_here

# Optional: route openai/anthropic calls through the JHU WSE AI Gateway
# (https://gateway.engineering.jhu.edu/docs) instead of hitting OpenAI/
# Anthropic directly. Requires a gateway project + key (sign in with your
# JHED). Leave USE_WSE_GATEWAY unset/false to use OPENAI_API_KEY/
# ANTHROPIC_API_KEY above as normal.
USE_WSE_GATEWAY=false
WSE_GATEWAY_KEY=jhu_live_sk_...
